# Copy to .env and fill in. .env is gitignored — never commit a real key.
# Verify with:  python tools/check_voices.py

# ── API key ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── The cast ───────────────────────────────────────────────────────────────
# Voice IDs from ElevenLabs Voice Design. See script/voice-casting.md for the
# exact design prompts used to create each one.

# The storyteller.
VOICE_NARRATOR=

# Etta, 5 — the plan. Bright, quick, decisive, faintly bossy.
VOICE_ETTA=

# Kip, 2 — the climber. High, sharp, clicky, utterly undaunted.
VOICE_KIP=

# Mo, 2 — the ear. Low, round, slow, watchful.
VOICE_MO=

# The Hushabaloo — the lonely collector. Big, soft, mournful, NEVER menacing.
VOICE_HUSHABALOO=
