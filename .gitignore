# Secrets — never commit ElevenLabs keys
.env
.env.*
!.env.example
*.key

# Generated audio IS committed. It has to be: GitHub Pages serves these files
# directly, so a deploy that regenerated them would need the API key as a CI secret
# and would burn credits on every push — and worse, would produce subtly different
# takes each time, so the book you tested is not the book that ships.
# Committed audio makes a deploy byte-for-byte what was reviewed.
# audio/provenance.json tracks what produced each file; change the text and
# tools/generate.py regenerates just that block.

# Standalone build output (base64-inlined, ~30MB — rebuildable from committed audio)
dist/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# OS
Thumbs.db
.DS_Store

# Local test scaffolding
.site/
test-results/
playwright-report/
